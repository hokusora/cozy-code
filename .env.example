# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Self-hosted Piston API execute URL for C++ (full STL) and Java execution.
# If omitted, /api/execute automatically falls back to the public Wandbox compiler API.
PISTON_API_URL=""
PISTON_API_KEY=""

# Optional: Local SQLite database file path for the Express development/preview server.
SQLITE_DB_PATH="./data/canvas-notebook.sqlite"
